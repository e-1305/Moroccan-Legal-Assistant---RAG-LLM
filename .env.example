# Copy to .env and fill in. Never commit .env.

# Option A: OpenAI (you can also paste the key in the app sidebar)
OPENAI_API_KEY="sk-your-openai-api-key"

# Option B: Azure OpenAI (used instead of OpenAI when AZ_OPENAI_API_KEY is set)
# AZ_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
# AZ_OPENAI_API_KEY="your-azure-openai-api-key"

# Silence Chroma's anonymous telemetry
ANONYMIZED_TELEMETRY=False
